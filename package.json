{
  "name": "annuaire-app",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "node dist/server.js",
    "build": "ng build --configuration production",
    "build:server": "tsc server.ts --outDir dist --module commonjs --target ES2020 --esModuleInterop --skipLibCheck --resolveJsonModule --moduleResolution node",
    "serve": "npm run build && npm run build:server && node dist/server.js",
    "dev": "ng serve --proxy-config proxy.conf.json"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^17.0.0",
    "@angular/common": "^17.0.0",
    "@angular/compiler": "^17.0.0",
    "@angular/core": "^17.0.0",
    "@angular/forms": "^17.0.0",
    "@angular/platform-browser": "^17.0.0",
    "@angular/platform-browser-dynamic": "^17.0.0",
    "axios": "^1.12.2",
    "cheerio": "^1.1.2",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "puppeteer": "^24.24.1",
    "rxjs": "^7.8.0",
    "selenium-webdriver": "^4.36.0",
    "tslib": "^2.6.0",
    "xlsx": "^0.18.5",
    "zone.js": "^0.14.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.0.0",
    "@angular/cli": "^17.0.0",
    "@angular/compiler-cli": "^17.0.0",
    "@types/cheerio": "^0.22.35",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.19.21",
    "@types/selenium-webdriver": "^4.35.1",
    "concurrently": "^8.2.2",
    "ts-node": "^10.9.2",
    "typescript": "~5.2.2"
  }
}
